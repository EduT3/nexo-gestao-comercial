{
  "name": "nexo-gestao-comercial",
  "version": "1.0.5",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build:local": "npm run typecheck && vite build --mode desktop && tsc -p tsconfig.local.json && node scripts/generate-build-info.mjs",
    "start:local": "electron electron/main.cjs",
    "package:local": "npm run build:local && node scripts/package-local.mjs",
    "build:preview": "vite build --mode visual-preview",
    "dev": "concurrently -k -n API,WEB \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server/main.ts",
    "dev:web": "vite --host 127.0.0.1",
    "db:migrate": "tsx src/server/cli.ts migrate",
    "db:seed": "tsx src/server/cli.ts seed",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/main.js",
    "check": "npm run typecheck && npm test && npm run build",
    "package:installer": "npm run build:local && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.3",
    "@fontsource/inter": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "dotenv": "17.4.2",
    "electron-updater": "6.8.11",
    "exceljs": "^4.4.0",
    "fastify": "5.12.4",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "agent-browser": "0.37.1",
    "concurrently": "10.0.5",
    "electron": "44.4.1",
    "electron-builder": "26.18.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "main": "electron/main.cjs"
}
